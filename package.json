{
  "name": "account-vault-desktop",
  "version": "1.0.0",
  "description": "Standalone Linux Desktop Account & Storage Catalog App built with Electron, React, TypeScript, and isolated SQLite.",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "node ./scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:react": "vite build",
    "build": "npm run build:electron && npm run build:react",
    "build:standalone": "npm run build && electron-builder --linux dir && node ./scripts/post-standalone.mjs",
    "build:archive": "npm run build && electron-builder --linux tar.gz",
    "build:appimage": "npm run build && electron-builder --linux AppImage",
    "build:win": "npm run build && electron-builder --win",
    "build:win:nsis": "npm run build && electron-builder --win nsis",
    "build:win:portable": "npm run build && electron-builder --win portable",
    "build:win:zip": "npm run build && electron-builder --win zip",
    "build:mac": "npm run build && electron-builder --mac",
    "build:mac:dmg": "npm run build && electron-builder --mac dmg",
    "build:mac:zip": "npm run build && electron-builder --mac zip",
    "build:all": "npm run build && electron-builder --linux AppImage dir tar.gz",
    "build:cross-platform": "npm run build && electron-builder --linux AppImage dir tar.gz --win nsis portable zip --mac dmg zip",
    "start": "electron --no-sandbox .",
    "test": "node --test tests/**/*.test.mjs",
    "package": "npm run build && electron-builder --linux AppImage dir"
  },
  "build": {
    "appId": "com.cwt.accountvaultdesktop",
    "productName": "PikVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.wasm"
    ],
    "linux": {
      "executableName": "PikVault",
      "target": [
        "AppImage",
        "dir",
        "tar.gz"
      ],
      "category": "Utility",
      "icon": "public/android-chrome-512x512.png"
    },
    "win": {
      "executableName": "PikVault",
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PikVault",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "executableName": "PikVault",
      "category": "public.app-category.utilities",
      "target": [
        "zip",
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "dmg": {
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "sqlite",
    "linux",
    "desktop"
  ],
  "author": "Senior Developer",
  "license": "MIT",
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
